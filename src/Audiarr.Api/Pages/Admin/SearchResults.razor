@page "/admin/search"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Audiarr.Data.Context
@attribute [Authorize]
@inject NavigationManager Navigation
@inject AudiarrContext DbContext

<PageTitle>Search Results - Audiarr Admin</PageTitle>

<h1>Search Results</h1>

@if (!string.IsNullOrEmpty(searchQuery))
{
    <div class="mb-3">
        <h5>Results for "@searchQuery"</h5>
        <p class="text-muted">Found @totalResults results</p>
    </div>
}

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Searching...</span>
        </div>
    </div>
}
else if (!hasResults)
{
    <div class="alert alert-info">
        <h4>No Results Found</h4>
        <p>@(string.IsNullOrEmpty(searchQuery) ? "Please enter a search query." : $"No results found for '{searchQuery}'")</p>
        <a href="/admin" class="btn btn-primary">Back to Dashboard</a>
    </div>
}
else
{
    @if (artists.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">Artists (@artists.Count)</h3>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
                @foreach (var artist in artists)
                {
                    <div class="col">
                        <div class="card h-100 artist-card" @onclick="@(() => Navigation.NavigateTo($"/admin/artists/{artist.Id}"))">
                            <div class="card-body text-center">
                                <div class="artist-avatar mb-3">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <h6 class="card-title">@artist.Name</h6>
                                <p class="card-text">
                                    <small class="text-muted">
                                        @artist.AlbumCount album@(artist.AlbumCount != 1 ? "s" : "") • 
                                        @artist.TrackCount track@(artist.TrackCount != 1 ? "s" : "")
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (albums.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">Albums (@albums.Count)</h3>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
                @foreach (var album in albums)
                {
                    <div class="col">
                        <div class="card h-100 album-card" @onclick="@(() => Navigation.NavigateTo($"/admin/albums/{album.Id}"))">
                            <div class="album-cover-container">
                                @if (!string.IsNullOrEmpty(album.CoverArtPath))
                                {
                                    <img src="@($"/api/v2/albums/{album.Id}/cover")" 
                                         class="card-img-top album-cover" 
                                         alt="@album.Title">
                                }
                                else
                                {
                                    <div class="album-cover-placeholder">
                                        <span class="placeholder-icon">💿</span>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                <h6 class="card-title text-truncate" title="@album.Title">@album.Title</h6>
                                <p class="card-text">
                                    <small class="text-muted text-truncate d-block" title="@album.ArtistName">
                                        @album.ArtistName
                                    </small>
                                    <small class="text-muted">
                                        @if (album.Year.HasValue)
                                        {
                                            <span>@album.Year</span>
                                            <span> • </span>
                                        }
                                        @album.TrackCount track@(album.TrackCount != 1 ? "s" : "")
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (tracks.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">Tracks (@tracks.Count)</h3>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 50px">#</th>
                            <th>Title</th>
                            <th>Artist</th>
                            <th>Album</th>
                            <th style="width: 100px">Duration</th>
                            <th style="width: 100px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in tracks)
                        {
                            <tr>
                                <td>
                                    @if (track.TrackNumber.HasValue)
                                    {
                                        @track.TrackNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a href="/admin/tracks/@track.Id" class="text-decoration-none">
                                        @track.Title
                                    </a>
                                </td>
                                <td>
                                    <a href="/admin/artists/@track.ArtistId" class="text-decoration-none text-muted">
                                        @track.ArtistName
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(track.AlbumTitle))
                                    {
                                        <a href="/admin/albums/@track.AlbumId" class="text-decoration-none text-muted">
                                            @track.AlbumTitle
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@FormatDuration(track.DurationMs)</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="@(() => PlayTrack(track.Id))" @onclick:stopPropagation="true">
                                        <i class="bi bi-play-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<style>
    .artist-card, .album-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .artist-card:hover, .album-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }
    
    .artist-avatar {
        font-size: 4rem;
        color: #6c757d;
    }
    
    .album-cover-container {
        position: relative;
        padding-top: 100%;
        background: #f0f0f0;
        overflow: hidden;
    }
    
    .album-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .album-cover-placeholder {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .placeholder-icon {
        font-size: 4rem;
        opacity: 0.7;
    }
</style>

@code {
    private string searchQuery = "";
    private bool isLoading = true;
    private bool hasResults = false;
    private int totalResults = 0;
    private List<ArtistResult> artists = new();
    private List<AlbumResult> albums = new();
    private List<TrackResult> tracks = new();

    public class ArtistResult
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public int AlbumCount { get; set; }
        public int TrackCount { get; set; }
    }

    public class AlbumResult
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public int? Year { get; set; }
        public string? CoverArtPath { get; set; }
        public int TrackCount { get; set; }
    }

    public class TrackResult
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string? AlbumId { get; set; }
        public string? AlbumTitle { get; set; }
        public int DurationMs { get; set; }
        public int? TrackNumber { get; set; }
        public int? DiscNumber { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var value))
        {
            searchQuery = value.ToString();
            await PerformSearch();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            isLoading = false;
            return;
        }

        isLoading = true;

        try
        {
            var searchTerm = searchQuery.ToLower();
            var limit = 50;

            // Search artists
            artists = await DbContext.Artists
                .Where(a => a.Name.ToLower().Contains(searchTerm) || 
                           a.NameNormalized.Contains(searchTerm))
                .OrderBy(a => a.Name.Length)
                .ThenBy(a => a.Name)
                .Take(limit)
                .Select(a => new ArtistResult
                {
                    Id = a.Id,
                    Name = a.Name,
                    AlbumCount = DbContext.Albums.Count(al => al.ArtistId == a.Id),
                    TrackCount = DbContext.Tracks.Count(t => t.ArtistId == a.Id)
                })
                .ToListAsync();

            // Search albums
            albums = await DbContext.Albums
                .Include(a => a.Artist)
                .Where(a => a.Title.ToLower().Contains(searchTerm) || 
                           a.TitleNormalized.Contains(searchTerm))
                .OrderBy(a => a.Title.Length)
                .ThenBy(a => a.Title)
                .Take(limit)
                .Select(a => new AlbumResult
                {
                    Id = a.Id,
                    Title = a.Title,
                    ArtistId = a.ArtistId,
                    ArtistName = a.Artist.Name,
                    Year = a.Year ?? a.ReleaseYear,
                    CoverArtPath = a.CoverArtPath,
                    TrackCount = DbContext.Tracks.Count(t => t.AlbumId == a.Id)
                })
                .ToListAsync();

            // Search tracks
            tracks = await DbContext.Tracks
                .Include(t => t.Artist)
                .Include(t => t.Album)
                .Where(t => t.Title.ToLower().Contains(searchTerm))
                .OrderBy(t => t.Title.Length)
                .ThenBy(t => t.Title)
                .Take(limit)
                .Select(t => new TrackResult
                {
                    Id = t.Id,
                    Title = t.Title,
                    ArtistId = t.ArtistId,
                    ArtistName = t.Artist.Name,
                    AlbumId = t.AlbumId,
                    AlbumTitle = t.Album != null ? t.Album.Title : null,
                    DurationMs = t.DurationMs,
                    TrackNumber = t.TrackNumber,
                    DiscNumber = t.DiscNumber
                })
                .ToListAsync();

            totalResults = artists.Count + albums.Count + tracks.Count;
            hasResults = totalResults > 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            hasResults = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDuration(int durationMs)
    {
        var duration = TimeSpan.FromMilliseconds(durationMs);
        return $"{(int)duration.TotalMinutes}:{duration.Seconds:D2}";
    }

    private void PlayTrack(string trackId)
    {
        // TODO: Implement play functionality
        Console.WriteLine($"Play track: {trackId}");
    }

}