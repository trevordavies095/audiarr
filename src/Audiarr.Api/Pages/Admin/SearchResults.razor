@page "/admin/search"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Audiarr.Data.Context
@using Audiarr.Core.Entities
@attribute [Authorize]
@inject NavigationManager Navigation
@inject AudiarrContext DbContext

<PageTitle>Search Results - Audiarr Admin</PageTitle>

<h1>Search Results</h1>

@if (!string.IsNullOrEmpty(searchQuery))
{
    <div class="mb-3">
        <h5>Results for "@searchQuery"</h5>
        <p class="text-muted">Found @totalResults results</p>
    </div>
}

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Searching...</span>
        </div>
    </div>
}
else if (!hasResults)
{
    <div class="alert alert-info">
        <h4>No Results Found</h4>
        <p>@(string.IsNullOrEmpty(searchQuery) ? "Please enter a search query." : $"No results found for '{searchQuery}'")</p>
        <a href="/admin" class="btn btn-primary">Back to Dashboard</a>
    </div>
}
else
{
    @if (artists.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">Artists (@artists.Count)</h3>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
                @foreach (var artist in artists)
                {
                    <div class="col">
                        <div class="card h-100 artist-card" @onclick="@(() => Navigation.NavigateTo($"/admin/artists/{artist.Id}"))">
                            <div class="card-body text-center">
                                <div class="artist-avatar mb-3">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <h6 class="card-title">@artist.Name</h6>
                                <p class="card-text">
                                    <small class="text-muted">
                                        @artist.AlbumCount album@(artist.AlbumCount != 1 ? "s" : "") • 
                                        @artist.TrackCount track@(artist.TrackCount != 1 ? "s" : "")
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (albums.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">Albums (@albums.Count)</h3>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
                @foreach (var album in albums)
                {
                    <div class="col">
                        <div class="card h-100 album-card" @onclick="@(() => Navigation.NavigateTo($"/admin/albums/{album.Id}"))">
                            <div class="album-cover-container">
                                @if (!string.IsNullOrEmpty(album.CoverArtPath))
                                {
                                    <img src="@($"/api/v2/albums/{album.Id}/cover")" 
                                         class="card-img-top album-cover" 
                                         alt="@album.Title">
                                }
                                else
                                {
                                    <div class="album-cover-placeholder">
                                        <span class="placeholder-icon">💿</span>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                <h6 class="card-title text-truncate" title="@album.Title">@album.Title</h6>
                                <p class="card-text">
                                    <small class="text-muted text-truncate d-block" title="@(album.ArtistNames != null && album.ArtistNames.Length > 0 ? string.Join(", ", album.ArtistNames) : album.ArtistName)">
                                        @if (album.ArtistNames != null && album.ArtistNames.Length > 0)
                                        {
                                            @for (int i = 0; i < album.ArtistNames.Length; i++)
                                            {
                                                <a href="/admin/artists/@album.ArtistIds[i]" @onclick:stopPropagation="true">
                                                    @album.ArtistNames[i]
                                                </a>
                                                @if (i < album.ArtistNames.Length - 1)
                                                {
                                                    <text>, </text>
                                                }
                                            }
                                        }
                                        else if (!string.IsNullOrEmpty(album.ArtistId) && !string.IsNullOrEmpty(album.ArtistName))
                                        {
                                            <a href="/admin/artists/@album.ArtistId" @onclick:stopPropagation="true">
                                                @album.ArtistName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Unknown Artist</span>
                                        }
                                    </small>
                                    <small class="text-muted">
                                        @if (album.Year.HasValue)
                                        {
                                            <span>@album.Year</span>
                                            <span> • </span>
                                        }
                                        @album.TrackCount track@(album.TrackCount != 1 ? "s" : "")
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (tracks.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3">Tracks (@tracks.Count)</h3>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 50px">#</th>
                            <th>Title</th>
                            <th>Artist</th>
                            <th>Album</th>
                            <th style="width: 100px">Duration</th>
                            <th style="width: 100px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in tracks)
                        {
                            <tr>
                                <td>
                                    @if (track.TrackNumber.HasValue)
                                    {
                                        @track.TrackNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a href="/admin/tracks/@track.Id" class="text-decoration-none">
                                        @track.Title
                                    </a>
                                    @if (track.Genres != null && track.Genres.Length > 0)
                                    {
                                        @foreach (var genre in track.Genres)
                                        {
                                            <span class="badge bg-secondary ms-2">@genre</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (track.ArtistNames != null && track.ArtistNames.Length > 0)
                                    {
                                        @for (int i = 0; i < track.ArtistNames.Length; i++)
                                        {
                                            <a href="/admin/artists/@track.ArtistIds[i]" class="text-decoration-none text-muted" @onclick:stopPropagation="true">
                                                @track.ArtistNames[i]
                                            </a>
                                            @if (i < track.ArtistNames.Length - 1)
                                            {
                                                <text>, </text>
                                            }
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(track.ArtistId) && !string.IsNullOrEmpty(track.ArtistName))
                                    {
                                        <a href="/admin/artists/@track.ArtistId" class="text-decoration-none text-muted" @onclick:stopPropagation="true">
                                            @track.ArtistName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown Artist</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(track.AlbumTitle))
                                    {
                                        <a href="/admin/albums/@track.AlbumId" class="text-decoration-none text-muted">
                                            @track.AlbumTitle
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@FormatDuration(track.DurationMs)</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="@(() => PlayTrack(track.Id))" @onclick:stopPropagation="true">
                                        <i class="bi bi-play-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<style>
    .artist-card, .album-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .artist-card:hover, .album-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }
    
    .artist-avatar {
        font-size: 4rem;
        color: #6c757d;
    }
    
    .album-cover-container {
        position: relative;
        padding-top: 100%;
        background: #f0f0f0;
        overflow: hidden;
    }
    
    .album-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .album-cover-placeholder {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .placeholder-icon {
        font-size: 4rem;
        opacity: 0.7;
    }
</style>

@code {
    private string searchQuery = "";
    private bool isLoading = true;
    private bool hasResults = false;
    private int totalResults = 0;
    private List<ArtistResult> artists = new();
    private List<AlbumResult> albums = new();
    private List<TrackResult> tracks = new();

    public class ArtistResult
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public int AlbumCount { get; set; }
        public int TrackCount { get; set; }
    }

    public class AlbumResult
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string[] ArtistIds { get; set; } = Array.Empty<string>();
        public string[] ArtistNames { get; set; } = Array.Empty<string>();
        public string[] Genres { get; set; } = Array.Empty<string>();
        public int? Year { get; set; }
        public string? CoverArtPath { get; set; }
        public int TrackCount { get; set; }
    }

    public class TrackResult
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string[] ArtistIds { get; set; } = Array.Empty<string>();
        public string[] ArtistNames { get; set; } = Array.Empty<string>();
        public string[] Genres { get; set; } = Array.Empty<string>();
        public string? AlbumId { get; set; }
        public string? AlbumTitle { get; set; }
        public int DurationMs { get; set; }
        public int? TrackNumber { get; set; }
        public int? DiscNumber { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var value))
        {
            searchQuery = value.ToString();
            await PerformSearch();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            isLoading = false;
            return;
        }

        isLoading = true;

        try
        {
            var searchTerm = searchQuery.ToLower();
            var limit = 50;

            // Search artists
            artists = await DbContext.Artists
                .Where(a => a.Name.ToLower().Contains(searchTerm) || 
                           (a.NameNormalized != null && a.NameNormalized.Contains(searchTerm)))
                .OrderBy(a => a.Name.Length)
                .ThenBy(a => a.Name)
                .Take(limit)
                .Select(a => new ArtistResult
                {
                    Id = a.Id,
                    Name = a.Name,
                    AlbumCount = DbContext.Albums.Count(al => al.ArtistId == a.Id || al.AlbumArtists.Any(aa => aa.ArtistId == a.Id)),
                    TrackCount = DbContext.Tracks.Count(t => t.ArtistId == a.Id || t.TrackArtists.Any(ta => ta.ArtistId == a.Id))
                })
                .ToListAsync();

            // Search albums
            var albumsList = await DbContext.Albums
                .Include(a => a.Artist)
                .Include(a => a.AlbumArtists).ThenInclude(aa => aa.Artist)
                .Include(a => a.AlbumGenres).ThenInclude(ag => ag.Genre)
                .Where(a => a.Title.ToLower().Contains(searchTerm) || 
                           (a.TitleNormalized != null && a.TitleNormalized.Contains(searchTerm)) ||
                           (a.Artist != null && a.Artist.Name.ToLower().Contains(searchTerm)) ||
                           (a.Genre != null && a.Genre.ToLower().Contains(searchTerm)) ||
                           a.AlbumArtists.Any(aa => aa.Artist != null && aa.Artist.Name.ToLower().Contains(searchTerm)) ||
                           a.AlbumGenres.Any(ag => ag.Genre != null && ag.Genre.Name.ToLower().Contains(searchTerm)))
                .OrderBy(a => a.Title.Length)
                .ThenBy(a => a.Title)
                .Take(limit)
                .ToListAsync();

            albums = albumsList.Select(a =>
            {
                // Build ordered artist list: primary artist first, then others alphabetically
                var primaryArtist = a.AlbumArtists
                    .FirstOrDefault(aa => aa.ArtistId == a.ArtistId && aa.Artist != null)
                    ?.Artist;

                // If primary artist not found in many-to-many collection but exists in single-value field, use it
                if (primaryArtist == null && !string.IsNullOrEmpty(a.ArtistId) && a.Artist != null)
                {
                    primaryArtist = a.Artist;
                }

                var otherArtists = a.AlbumArtists
                    .Where(aa => aa.Artist != null && aa.ArtistId != a.ArtistId)
                    .Select(aa => aa.Artist!)
                    .Distinct()
                    .OrderBy(ar => ar.Name)
                    .ToList();

                var allArtists = primaryArtist != null
                    ? new[] { primaryArtist }.Concat(otherArtists).ToList()
                    : otherArtists;

                // Fallback to single-value artist if no many-to-many data
                if (!allArtists.Any() && !string.IsNullOrEmpty(a.ArtistId))
                {
                    if (a.Artist != null)
                    {
                        allArtists = new List<Artist> { a.Artist };
                    }
                }

                var artistIds = allArtists.Select(ar => ar.Id).ToArray();
                var artistNames = allArtists.Select(ar => ar.Name).ToArray();

                // Build genre list: primary genre first (matching single-value Genre), then others alphabetically
                var primaryGenre = a.AlbumGenres
                    .FirstOrDefault(ag => ag.Genre != null && ag.Genre.Name == a.Genre)
                    ?.Genre;
                var otherGenres = a.AlbumGenres
                    .Where(ag => ag.Genre != null && ag.Genre.Name != a.Genre)
                    .Select(ag => ag.Genre!)
                    .Distinct()
                    .OrderBy(g => g.Name)
                    .ToList();

                var allGenres = primaryGenre != null
                    ? new[] { primaryGenre }.Concat(otherGenres).ToList()
                    : otherGenres;

                // Fallback to single-value genre if no many-to-many data
                string[] genres;
                if (!allGenres.Any() && !string.IsNullOrEmpty(a.Genre))
                {
                    // No many-to-many data, use single-value string
                    genres = new[] { a.Genre };
                }
                else
                {
                    genres = allGenres.Select(g => g.Name).ToArray();
                }

                return new AlbumResult
                {
                    Id = a.Id,
                    Title = a.Title,
                    ArtistId = a.ArtistId,
                    ArtistName = a.Artist?.Name ?? string.Empty,
                    ArtistIds = artistIds,
                    ArtistNames = artistNames,
                    Genres = genres,
                    Year = a.Year ?? a.ReleaseYear,
                    CoverArtPath = a.CoverArtPath,
                    TrackCount = DbContext.Tracks.Count(t => t.AlbumId == a.Id)
                };
            }).ToList();

            // Search tracks
            var tracksList = await DbContext.Tracks
                .Include(t => t.Artist)
                .Include(t => t.Album)
                .Include(t => t.TrackArtists).ThenInclude(ta => ta.Artist)
                .Include(t => t.TrackGenres).ThenInclude(tg => tg.Genre)
                .Where(t => t.Title.ToLower().Contains(searchTerm) ||
                           (t.Artist != null && t.Artist.Name.ToLower().Contains(searchTerm)) ||
                           (t.Genre != null && t.Genre.ToLower().Contains(searchTerm)) ||
                           t.TrackArtists.Any(ta => ta.Artist != null && ta.Artist.Name.ToLower().Contains(searchTerm)) ||
                           t.TrackGenres.Any(tg => tg.Genre != null && tg.Genre.Name.ToLower().Contains(searchTerm)))
                .OrderBy(t => t.Title.Length)
                .ThenBy(t => t.Title)
                .Take(limit)
                .ToListAsync();

            tracks = tracksList.Select(t =>
            {
                // Build ordered artist list: primary artist first, then others alphabetically
                var primaryArtist = t.TrackArtists
                    .FirstOrDefault(ta => ta.ArtistId == t.ArtistId && ta.Artist != null)
                    ?.Artist;

                // If primary artist not found in many-to-many collection but exists in single-value field, use it
                if (primaryArtist == null && !string.IsNullOrEmpty(t.ArtistId) && t.Artist != null)
                {
                    primaryArtist = t.Artist;
                }

                var otherArtists = t.TrackArtists
                    .Where(ta => ta.Artist != null && ta.ArtistId != t.ArtistId)
                    .Select(ta => ta.Artist!)
                    .Distinct()
                    .OrderBy(ar => ar.Name)
                    .ToList();

                var allArtists = primaryArtist != null
                    ? new[] { primaryArtist }.Concat(otherArtists).ToList()
                    : otherArtists;

                // Fallback to single-value artist if no many-to-many data
                if (!allArtists.Any() && !string.IsNullOrEmpty(t.ArtistId))
                {
                    if (t.Artist != null)
                    {
                        allArtists = new List<Artist> { t.Artist };
                    }
                }

                var artistIds = allArtists.Select(ar => ar.Id).ToArray();
                var artistNames = allArtists.Select(ar => ar.Name).ToArray();

                // Build genre list: primary genre first (matching single-value Genre), then others alphabetically
                var primaryGenre = t.TrackGenres
                    .FirstOrDefault(tg => tg.Genre != null && tg.Genre.Name == t.Genre)
                    ?.Genre;
                var otherGenres = t.TrackGenres
                    .Where(tg => tg.Genre != null && tg.Genre.Name != t.Genre)
                    .Select(tg => tg.Genre!)
                    .Distinct()
                    .OrderBy(g => g.Name)
                    .ToList();

                var allGenres = primaryGenre != null
                    ? new[] { primaryGenre }.Concat(otherGenres).ToList()
                    : otherGenres;

                // Fallback to single-value genre if no many-to-many data
                string[] genres;
                if (!allGenres.Any() && !string.IsNullOrEmpty(t.Genre))
                {
                    // No many-to-many data, use single-value string
                    genres = new[] { t.Genre };
                }
                else
                {
                    genres = allGenres.Select(g => g.Name).ToArray();
                }

                return new TrackResult
                {
                    Id = t.Id,
                    Title = t.Title,
                    ArtistId = t.ArtistId,
                    ArtistName = t.Artist != null ? t.Artist.Name : string.Empty,
                    ArtistIds = artistIds,
                    ArtistNames = artistNames,
                    Genres = genres,
                    AlbumId = t.AlbumId,
                    AlbumTitle = t.Album != null ? t.Album.Title : null,
                    DurationMs = t.DurationMs,
                    TrackNumber = t.TrackNumber,
                    DiscNumber = t.DiscNumber
                };
            }).ToList();

            totalResults = artists.Count + albums.Count + tracks.Count;
            hasResults = totalResults > 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            hasResults = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDuration(int durationMs)
    {
        var duration = TimeSpan.FromMilliseconds(durationMs);
        return $"{(int)duration.TotalMinutes}:{duration.Seconds:D2}";
    }

    private void PlayTrack(string trackId)
    {
        // TODO: Implement play functionality
        Console.WriteLine($"Play track: {trackId}");
    }

}