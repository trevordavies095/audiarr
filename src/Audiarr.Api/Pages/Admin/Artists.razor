@page "/admin/artists"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Audiarr.Data.Context
@using Audiarr.Core.Entities
@attribute [Authorize]
@inject AudiarrContext DbContext
@inject NavigationManager Navigation

<PageTitle>Artists - Audiarr Admin</PageTitle>

<h1>Artists</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text">🔍</span>
            <input type="text" class="form-control" placeholder="Search artists..." 
                   @bind="searchQuery" @bind:event="oninput" @onkeyup="@(async (e) => { if (e.Key == "Enter") await LoadArtists(); })">
            <button class="btn btn-primary" @onclick="LoadArtists">Search</button>
        </div>
    </div>
    <div class="col-md-6 text-end">
        <div class="btn-group" role="group">
            <button type="button" class="btn @(viewMode == "grid" ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="@(() => SetViewMode("grid"))">
                <i class="bi bi-grid-3x3-gap"></i> Grid
            </button>
            <button type="button" class="btn @(viewMode == "list" ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="@(() => SetViewMode("list"))">
                <i class="bi bi-list"></i> List
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!artists.Any())
{
    <div class="alert alert-info">
        <h4>No Artists Found</h4>
        <p>@(string.IsNullOrEmpty(searchQuery) ? "No artists in your library yet. Run a library scan to add music." : $"No artists found matching '{searchQuery}'")</p>
        @if (string.IsNullOrEmpty(searchQuery))
        {
            <a href="/admin/library" class="btn btn-primary">Go to Library Scanner</a>
        }
    </div>
}
else
{
    @if (viewMode == "grid")
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-4">
            @foreach (var artist in artists)
            {
                <div class="col">
                    <div class="card h-100 artist-card" @onclick="() => ViewArtist(artist.Id)">
                        <div class="card-body text-center">
                            <div class="artist-avatar mb-2">
                                <span class="display-4">🎤</span>
                            </div>
                            <h6 class="card-title text-truncate" title="@artist.Name">@artist.Name</h6>
                            <p class="card-text small text-muted">
                                @artist.AlbumCount album@(artist.AlbumCount != 1 ? "s" : "") • 
                                @artist.TrackCount track@(artist.TrackCount != 1 ? "s" : "")
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy("Name"))" class="sortable">
                            Artist Name
                            @if (sortField == "Name")
                            {
                                <span class="sort-indicator">@(sortAscending ? "▲" : "▼")</span>
                            }
                        </th>
                        <th @onclick="@(() => SortBy("AlbumCount"))" class="sortable">
                            Albums
                            @if (sortField == "AlbumCount")
                            {
                                <span class="sort-indicator">@(sortAscending ? "▲" : "▼")</span>
                            }
                        </th>
                        <th @onclick="@(() => SortBy("TrackCount"))" class="sortable">
                            Tracks
                            @if (sortField == "TrackCount")
                            {
                                <span class="sort-indicator">@(sortAscending ? "▲" : "▼")</span>
                            }
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artist in artists)
                    {
                        <tr @onclick="() => ViewArtist(artist.Id)" style="cursor: pointer;">
                            <td>
                                <strong>@artist.Name</strong>
                            </td>
                            <td>@artist.AlbumCount</td>
                            <td>@artist.TrackCount</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true" 
                                        @onclick="() => ViewArtist(artist.Id)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <nav aria-label="Artists pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PreviousPage" disabled="@(currentPage == 1)">Previous</button>
            </li>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                var pageNum = i;
                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage" disabled="@(currentPage == totalPages)">Next</button>
            </li>
        </ul>
    </nav>
}

<style>
    .artist-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .artist-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    }
    
    .artist-avatar {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
    }
    
    .sortable {
        cursor: pointer;
        user-select: none;
    }
    
    .sortable:hover {
        background-color: rgba(0,0,0,0.05);
    }
    
    .sort-indicator {
        font-size: 0.8em;
        margin-left: 5px;
    }
</style>

@code {
    private List<ArtistViewModel> artists = new();
    private bool isLoading = true;
    private string searchQuery = "";
    private string viewMode = "grid";
    private int currentPage = 1;
    private int pageSize = 24;
    private int totalPages = 1;
    private int totalArtists = 0;
    private string sortField = "Name";
    private bool sortAscending = true;

    public class ArtistViewModel
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string? SortName { get; set; }
        public int AlbumCount { get; set; }
        public int TrackCount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadArtists();
    }

    private async Task LoadArtists()
    {
        isLoading = true;
        
        var query = DbContext.Artists.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query = query.Where(a => a.Name.Contains(searchQuery));
        }

        totalArtists = await query.CountAsync();
        totalPages = (int)Math.Ceiling((double)totalArtists / pageSize);

        // Apply sorting with a fresh query to avoid include issues
        var sortedQuery = sortField switch
        {
            "Name" => sortAscending ? query.OrderBy(a => a.SortName ?? a.Name) : query.OrderByDescending(a => a.SortName ?? a.Name),
            "AlbumCount" => sortAscending ? 
                query.OrderBy(a => DbContext.Albums.Count(al => al.ArtistId == a.Id || al.AlbumArtists.Any(aa => aa.ArtistId == a.Id))) : 
                query.OrderByDescending(a => DbContext.Albums.Count(al => al.ArtistId == a.Id || al.AlbumArtists.Any(aa => aa.ArtistId == a.Id))),
            "TrackCount" => sortAscending ? 
                query.OrderBy(a => DbContext.Tracks.Count(t => t.ArtistId == a.Id || t.TrackArtists.Any(ta => ta.ArtistId == a.Id))) :
                query.OrderByDescending(a => DbContext.Tracks.Count(t => t.ArtistId == a.Id || t.TrackArtists.Any(ta => ta.ArtistId == a.Id))),
            _ => query.OrderBy(a => a.SortName ?? a.Name)
        };

        artists = await sortedQuery
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .Select(a => new ArtistViewModel
            {
                Id = a.Id,
                Name = a.Name,
                SortName = a.SortName,
                AlbumCount = DbContext.Albums.Count(al => al.ArtistId == a.Id || al.AlbumArtists.Any(aa => aa.ArtistId == a.Id)),
                TrackCount = DbContext.Tracks.Count(t => t.ArtistId == a.Id || t.TrackArtists.Any(ta => ta.ArtistId == a.Id))
            })
            .ToListAsync();

        isLoading = false;
    }

    private void SetViewMode(string mode)
    {
        viewMode = mode;
    }

    private async Task SortBy(string field)
    {
        if (sortField == field)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortField = field;
            sortAscending = true;
        }
        await LoadArtists();
    }

    private void ViewArtist(string artistId)
    {
        Navigation.NavigateTo($"/admin/artists/{artistId}");
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadArtists();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadArtists();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadArtists();
        }
    }
}