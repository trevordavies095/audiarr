@page "/admin/albums"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Audiarr.Data.Context
@using Audiarr.Core.Entities
@attribute [Authorize]
@inject AudiarrContext DbContext
@inject NavigationManager Navigation

<PageTitle>Albums - Audiarr Admin</PageTitle>

<h1>Albums</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text">🔍</span>
            <input type="text" class="form-control" placeholder="Search albums or artists..." 
                   @bind="searchQuery" @bind:event="oninput" @onkeyup="@(async (e) => { if (e.Key == "Enter") await LoadAlbums(); })">
            <button class="btn btn-primary" @onclick="LoadAlbums">Search</button>
        </div>
    </div>
    <div class="col-md-6 text-end">
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-primary @(sortBy == "recent" ? "active" : "")" 
                    @onclick="@(() => ChangeSortBy("recent"))">
                Recent
            </button>
            <button type="button" class="btn btn-outline-primary @(sortBy == "alphabetical" ? "active" : "")" 
                    @onclick="@(() => ChangeSortBy("alphabetical"))">
                A-Z
            </button>
            <button type="button" class="btn btn-outline-primary @(sortBy == "year" ? "active" : "")" 
                    @onclick="@(() => ChangeSortBy("year"))">
                Year
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!albums.Any())
{
    <div class="alert alert-info">
        <h4>No Albums Found</h4>
        <p>@(string.IsNullOrEmpty(searchQuery) ? "No albums in your library yet. Run a library scan to add music." : $"No albums found matching '{searchQuery}'")</p>
        @if (string.IsNullOrEmpty(searchQuery))
        {
            <a href="/admin/library" class="btn btn-primary">Go to Library Scanner</a>
        }
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
        @foreach (var album in albums)
        {
            <div class="col">
                <div class="card h-100 album-card" @onclick="() => ViewAlbum(album.Id)">
                    <div class="album-cover-container">
                        @if (!string.IsNullOrEmpty(album.CoverArtPath))
                        {
                            <img src="@($"/api/v2/albums/{album.Id}/cover")" 
                                 class="card-img-top album-cover" 
                                 alt="@album.Title" 
                                 @onerror="@(() => HandleImageError(album.Id))">
                        }
                        else
                        {
                            <div class="album-cover-placeholder">
                                <span class="placeholder-icon">💿</span>
                            </div>
                        }
                        <div class="album-overlay">
                            <button class="btn btn-circle btn-play" @onclick:stopPropagation="true" 
                                    @onclick="() => PlayAlbum(album.Id)" title="Play Album">
                                ▶️
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title text-truncate" title="@album.Title">@album.Title</h6>
                        <p class="card-text">
                            <small class="text-muted text-truncate d-block" title="@album.ArtistName">
                                @album.ArtistName
                            </small>
                            <small class="text-muted">
                                @if (album.Year.HasValue)
                                {
                                    <span>@album.Year</span>
                                    <span> • </span>
                                }
                                @album.TrackCount track@(album.TrackCount != 1 ? "s" : "")
                            </small>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Albums pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PreviousPage" disabled="@(currentPage == 1)">Previous</button>
            </li>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                var pageNum = i;
                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage" disabled="@(currentPage == totalPages)">Next</button>
            </li>
        </ul>
    </nav>
}

<style>
    .album-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
    }
    
    .album-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }
    
    .album-cover-container {
        position: relative;
        padding-top: 100%; /* 1:1 Aspect Ratio */
        background: #f0f0f0;
        overflow: hidden;
    }
    
    .album-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .album-cover-placeholder {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .placeholder-icon {
        font-size: 4rem;
        opacity: 0.7;
    }
    
    .album-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s;
    }
    
    .album-card:hover .album-overlay {
        opacity: 1;
    }
    
    .btn-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    
    .btn-play {
        background: rgba(255,255,255,0.9);
        border: none;
        transition: transform 0.2s;
    }
    
    .btn-play:hover {
        transform: scale(1.1);
        background: white;
    }
</style>

@code {
    private List<AlbumViewModel> albums = new();
    private bool isLoading = true;
    private string searchQuery = "";
    private string sortBy = "recent";
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private int totalAlbums = 0;
    private HashSet<string> failedImages = new();

    public class AlbumViewModel
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public int? Year { get; set; }
        public int TrackCount { get; set; }
        public string? CoverArtPath { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAlbums();
    }

    private async Task LoadAlbums()
    {
        isLoading = true;
        
        var query = DbContext.Albums
            .Include(a => a.Artist)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query = query.Where(a => 
                a.Title.Contains(searchQuery) || 
                a.Artist.Name.Contains(searchQuery));
        }

        totalAlbums = await query.CountAsync();
        totalPages = (int)Math.Ceiling((double)totalAlbums / pageSize);

        // Apply sorting
        query = sortBy switch
        {
            "recent" => query.OrderByDescending(a => a.CreatedAt),
            "alphabetical" => query.OrderBy(a => a.Title),
            "year" => query.OrderByDescending(a => a.Year ?? 0).ThenBy(a => a.Title),
            _ => query.OrderByDescending(a => a.CreatedAt)
        };

        albums = await query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .Select(a => new AlbumViewModel
            {
                Id = a.Id,
                Title = a.Title,
                ArtistId = a.ArtistId,
                ArtistName = a.Artist.Name,
                Year = a.Year,
                TrackCount = DbContext.Tracks.Count(t => t.AlbumId == a.Id),
                CoverArtPath = a.CoverArtPath,
                CreatedAt = a.CreatedAt
            })
            .ToListAsync();

        isLoading = false;
    }

    private async Task ChangeSortBy(string newSortBy)
    {
        sortBy = newSortBy;
        currentPage = 1;
        await LoadAlbums();
    }

    private void ViewAlbum(string albumId)
    {
        Navigation.NavigateTo($"/admin/albums/{albumId}");
    }

    private void PlayAlbum(string albumId)
    {
        // TODO: Implement play functionality
        Console.WriteLine($"Play album: {albumId}");
    }

    private void HandleImageError(string albumId)
    {
        failedImages.Add(albumId);
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadAlbums();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadAlbums();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadAlbums();
        }
    }
}