@page "/admin/library"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Audiarr.Services.Auth
@using Audiarr.Core.Interfaces
@using System.Text.Json
@attribute [Authorize]
@inject ScannerBackgroundService ScannerService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Environment
@implements IAsyncDisposable

<PageTitle>Library Management - Audiarr Admin</PageTitle>

<h1>Library Management</h1>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Library Scanner</h5>
                
                @if (isScanning)
                {
                    <div class="alert alert-info">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Scanning in progress...</span>
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div class="progress mt-3">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                 role="progressbar" 
                                 style="width: @(scanProgress)%"
                                 aria-valuenow="@scanProgress" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                @scanProgress.ToString("F1")%
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(scanMessage))
                        {
                            <small class="text-muted mt-2 d-block">@scanMessage</small>
                        }
                    </div>
                }
                
                @if (scanComplete)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Scan Complete!</strong>
                        <ul class="mb-0 mt-2">
                            <li>Total Files: @lastScanResult?.totalFiles</li>
                            <li>New Tracks: @lastScanResult?.newTracks</li>
                            <li>Updated Tracks: @lastScanResult?.updatedTracks</li>
                            @if (lastScanResult?.errors > 0)
                            {
                                <li class="text-danger">Errors: @lastScanResult?.errors</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" @onclick="() => scanComplete = false"></button>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error!</strong> @errorMessage
                        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                    </div>
                }
                
                <div class="mb-3">
                    <label for="libraryPath" class="form-label">Library Path</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="libraryPath" @bind="libraryPath" 
                               placeholder="/path/to/music/library" disabled="@isScanning" />
                        <button class="btn btn-primary" @onclick="StartScan" disabled="@(isScanning || string.IsNullOrWhiteSpace(libraryPath))">
                            @if (isScanning)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Scanning...</span>
                            }
                            else
                            {
                                <span>Start Scan</span>
                            }
                        </button>
                    </div>
                    <small class="form-text text-muted">
                        Enter the full path to your music library directory
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Supported Formats</h5>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var format in supportedFormats)
                    {
                        <span class="badge bg-secondary">@format</span>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Scan History</h5>
                @if (scanHistory.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var scan in scanHistory.Take(5))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">@scan.completedAt.ToString("g")</small>
                                    <div>Files: @scan.totalFiles | New: @scan.newTracks | Updated: @scan.updatedTracks</div>
                                </div>
                                @if (scan.errors > 0)
                                {
                                    <span class="badge bg-danger">@scan.errors errors</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No scan history available</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private string libraryPath = "";
    private bool isScanning = false;
    private bool scanComplete = false;
    private double scanProgress = 0;
    private string scanMessage = "";
    private string errorMessage = "";
    private ScanCompleteResult? lastScanResult;
    private List<ScanCompleteResult> scanHistory = new();
    private string[] supportedFormats = { ".mp3", ".flac", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".wma", ".alac", ".ape", ".wv", ".mka" };

    public class ScanProgressResult
    {
        public int processed { get; set; }
        public int total { get; set; }
        public string message { get; set; } = "";
        public double percentComplete { get; set; }
    }

    public class ScanCompleteResult
    {
        public int totalFiles { get; set; }
        public int newTracks { get; set; }
        public int updatedTracks { get; set; }
        public int errors { get; set; }
        public DateTime completedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Set default library path based on environment
        // Check if running in Docker (path /music exists) or local development
        if (System.IO.Directory.Exists("/music"))
        {
            libraryPath = "/music";  // Docker container path
        }
        else if (Environment.IsDevelopment())
        {
            // Local development path
            var projectRoot = System.IO.Path.GetDirectoryName(Environment.ContentRootPath);
            libraryPath = System.IO.Path.Combine(Environment.ContentRootPath, "test-music");
        }
        else
        {
            libraryPath = "/music";  // Default to Docker path in production
        }

        // Initialize SignalR connection with authentication
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/scan"), options =>
            {
                options.UseDefaultCredentials = true;
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<ScanProgressResult>("ScanProgress", (progress) =>
        {
            scanProgress = progress.percentComplete;
            scanMessage = progress.message ?? "";
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<ScanCompleteResult>("ScanComplete", (result) =>
        {
            isScanning = false;
            scanComplete = true;
            lastScanResult = result;
            scanHistory.Insert(0, result);
            scanProgress = 0;
            scanMessage = "";
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<string>("ScanError", (error) =>
        {
            isScanning = false;
            errorMessage = error;
            scanProgress = 0;
            scanMessage = "";
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to connect to scan hub: {ex.Message}";
        }
    }

    private async Task StartScan()
    {
        if (string.IsNullOrWhiteSpace(libraryPath))
        {
            errorMessage = "Please enter a library path";
            return;
        }

        isScanning = true;
        scanComplete = false;
        errorMessage = "";
        scanProgress = 0;
        scanMessage = "Initializing scan...";

        var request = new ScanRequest
        {
            LibraryPath = libraryPath,
            RequestId = Guid.NewGuid().ToString(),
            RequestedAt = DateTime.UtcNow
        };

        var queued = await ScannerService.QueueScanAsync(request);
        if (!queued)
        {
            isScanning = false;
            errorMessage = "Failed to queue scan request";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}