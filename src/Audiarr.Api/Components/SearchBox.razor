@using System.Timers
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Audiarr.Data.Context
@using Audiarr.Core.Entities
@inject NavigationManager Navigation
@inject AudiarrContext DbContext

<div class="search-container">
    <div class="search-box @(isExpanded ? "expanded" : "")">
        <div class="input-group">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control" placeholder="Search artists, albums, tracks..." 
                   @bind="searchQuery" @bind:event="oninput" 
                   @onkeyup="HandleKeyUp"
                   @onfocus="@(() => isExpanded = true)"
                   @ref="searchInput">
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
        
        @if (isExpanded && ((artistResults.Any() || albumResults.Any() || trackResults.Any()) || isSearching))
        {
            <div class="search-results">
                @if (isSearching)
                {
                    <div class="search-loading">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">Searching...</span>
                        </div>
                        <span class="ms-2">Searching...</span>
                    </div>
                }
                else if (!artistResults.Any() && !albumResults.Any() && !trackResults.Any() && !string.IsNullOrEmpty(searchQuery))
                {
                    <div class="no-results">
                        No results found for "@searchQuery"
                    </div>
                }
                else
                {
                    @if (artistResults.Any())
                    {
                        <div class="result-section">
                            <div class="result-header">Artists</div>
                            @foreach (var artist in artistResults)
                            {
                                <div class="result-item" @onclick="@(() => NavigateToArtist(artist.Id))">
                                    <i class="bi bi-person-circle me-2"></i>
                                    <div class="result-info">
                                        <div class="result-title">@artist.Name</div>
                                        <div class="result-subtitle">@artist.AlbumCount albums • @artist.TrackCount tracks</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    @if (albumResults.Any())
                    {
                        <div class="result-section">
                            <div class="result-header">Albums</div>
                            @foreach (var album in albumResults)
                            {
                                <div class="result-item" @onclick="@(() => NavigateToAlbum(album.Id))">
                                    <i class="bi bi-disc me-2"></i>
                                    <div class="result-info">
                                        <div class="result-title">@album.Title</div>
                                        <div class="result-subtitle">
                                            @if (album.ArtistNames != null && album.ArtistNames.Length > 0)
                                            {
                                                @string.Join(", ", album.ArtistNames.Take(2))
                                                @if (album.ArtistNames.Length > 2)
                                                {
                                                    <text>...</text>
                                                }
                                            }
                                            else if (!string.IsNullOrEmpty(album.ArtistName))
                                            {
                                                @album.ArtistName
                                            }
                                            else
                                            {
                                                <text>Unknown Artist</text>
                                            }
                                            @if (album.Year.HasValue)
                                            {
                                                <span> • @album.Year</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    @if (trackResults.Any())
                    {
                        <div class="result-section">
                            <div class="result-header">Tracks</div>
                            @foreach (var track in trackResults)
                            {
                                <div class="result-item" @onclick="@(() => NavigateToTrack(track.Id))">
                                    <i class="bi bi-music-note me-2"></i>
                                    <div class="result-info">
                                        <div class="result-title">@track.Title</div>
                                        <div class="result-subtitle">
                                            @if (track.ArtistNames != null && track.ArtistNames.Length > 0)
                                            {
                                                @string.Join(", ", track.ArtistNames.Take(2))
                                                @if (track.ArtistNames.Length > 2)
                                                {
                                                    <text>...</text>
                                                }
                                            }
                                            else if (!string.IsNullOrEmpty(track.ArtistName))
                                            {
                                                @track.ArtistName
                                            }
                                            else
                                            {
                                                <text>Unknown Artist</text>
                                            }
                                            @if (!string.IsNullOrEmpty(track.AlbumTitle))
                                            {
                                                <span> • @track.AlbumTitle</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    @if (totalResults > 5)
                    {
                        <div class="result-footer">
                            <button class="btn btn-link btn-sm" @onclick="ViewAllResults">
                                View all @totalResults results
                            </button>
                        </div>
                    }
                }
            </div>
        }
    </div>
    
    @if (isExpanded)
    {
        <div class="search-backdrop" @onclick="@(() => isExpanded = false)"></div>
    }
</div>

<style>
    .search-container {
        position: relative;
        width: 100%;
        max-width: 500px;
    }
    
    .search-box {
        position: relative;
        z-index: 1001;
    }
    
    .search-box.expanded .input-group {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }
    
    .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #dee2e6;
        border-top: none;
        border-bottom-left-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
        max-height: 400px;
        overflow-y: auto;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .search-loading {
        padding: 1rem;
        text-align: center;
        color: #6c757d;
    }
    
    .no-results {
        padding: 1rem;
        text-align: center;
        color: #6c757d;
    }
    
    .result-section {
        border-bottom: 1px solid #e9ecef;
    }
    
    .result-section:last-child {
        border-bottom: none;
    }
    
    .result-header {
        padding: 0.5rem 1rem;
        background: #f8f9fa;
        font-weight: 600;
        font-size: 0.875rem;
        color: #495057;
        text-transform: uppercase;
    }
    
    .result-item {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        cursor: pointer;
        transition: background-color 0.15s;
    }
    
    .result-item:hover {
        background: #f8f9fa;
    }
    
    .result-item i {
        font-size: 1.25rem;
        color: #6c757d;
    }
    
    .result-info {
        flex: 1;
        min-width: 0;
    }
    
    .result-title {
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .result-subtitle {
        font-size: 0.875rem;
        color: #6c757d;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .result-footer {
        padding: 0.75rem 1rem;
        background: #f8f9fa;
        text-align: center;
        border-top: 1px solid #e9ecef;
    }
    
    .search-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.3);
        z-index: 1000;
    }
</style>

@code {
    private string searchQuery = "";
    private bool isExpanded = false;
    private bool isSearching = false;
    private ElementReference searchInput;
    private Timer? debounceTimer;
    private List<ArtistResult> artistResults = new();
    private List<AlbumResult> albumResults = new();
    private List<TrackResult> trackResults = new();
    private int totalResults = 0;

    protected override void OnInitialized()
    {
        debounceTimer = new Timer(300);
        debounceTimer.Elapsed += async (sender, e) => await PerformSearch();
        debounceTimer.AutoReset = false;
    }

    private Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            ViewAllResults();
        }
        else if (e.Key == "Escape")
        {
            isExpanded = false;
        }
        else
        {
            debounceTimer?.Stop();
            debounceTimer?.Start();
        }
        return Task.CompletedTask;
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 2)
        {
            artistResults.Clear();
            albumResults.Clear();
            trackResults.Clear();
            totalResults = 0;
            await InvokeAsync(StateHasChanged);
            return;
        }

        isSearching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var searchTerm = searchQuery.ToLower();
            var limit = 5;

            // Search artists
            artistResults = await DbContext.Artists
                .Where(a => a.Name.ToLower().Contains(searchTerm) || 
                           (a.NameNormalized != null && a.NameNormalized.Contains(searchTerm)))
                .OrderBy(a => a.Name.Length)
                .ThenBy(a => a.Name)
                .Take(limit)
                .Select(a => new ArtistResult
                {
                    Id = a.Id,
                    Name = a.Name,
                    AlbumCount = DbContext.Albums.Count(al => al.ArtistId == a.Id || al.AlbumArtists.Any(aa => aa.ArtistId == a.Id)),
                    TrackCount = DbContext.Tracks.Count(t => t.ArtistId == a.Id || t.TrackArtists.Any(ta => ta.ArtistId == a.Id))
                })
                .ToListAsync();

            // Search albums
            var albumsList = await DbContext.Albums
                .Include(a => a.Artist)
                .Include(a => a.AlbumArtists).ThenInclude(aa => aa.Artist)
                .Include(a => a.AlbumGenres).ThenInclude(ag => ag.Genre)
                .Where(a => a.Title.ToLower().Contains(searchTerm) || 
                           (a.TitleNormalized != null && a.TitleNormalized.Contains(searchTerm)) ||
                           (a.Artist != null && a.Artist.Name.ToLower().Contains(searchTerm)) ||
                           (a.Genre != null && a.Genre.ToLower().Contains(searchTerm)) ||
                           a.AlbumArtists.Any(aa => aa.Artist != null && aa.Artist.Name.ToLower().Contains(searchTerm)) ||
                           a.AlbumGenres.Any(ag => ag.Genre != null && ag.Genre.Name.ToLower().Contains(searchTerm)))
                .OrderBy(a => a.Title.Length)
                .ThenBy(a => a.Title)
                .Take(limit)
                .ToListAsync();

            // Batch query track counts to avoid N+1 queries
            var albumIds = albumsList.Select(a => a.Id).ToList();
            var trackCounts = await DbContext.Tracks
                .Where(t => albumIds.Contains(t.AlbumId))
                .GroupBy(t => t.AlbumId)
                .ToDictionaryAsync(g => g.Key, g => g.Count());

            albumResults = albumsList.Select(a =>
            {
                // Build ordered artist list: primary artist first, then others alphabetically
                var primaryArtist = a.AlbumArtists
                    .FirstOrDefault(aa => aa.ArtistId == a.ArtistId && aa.Artist != null)
                    ?.Artist;

                // If primary artist not found in many-to-many collection but exists in single-value field, use it
                if (primaryArtist == null && !string.IsNullOrEmpty(a.ArtistId) && a.Artist != null)
                {
                    primaryArtist = a.Artist;
                }

                var otherArtists = a.AlbumArtists
                    .Where(aa => aa.Artist != null && aa.ArtistId != a.ArtistId)
                    .Select(aa => aa.Artist!)
                    .Distinct()
                    .OrderBy(ar => ar.Name)
                    .ToList();

                var allArtists = primaryArtist != null
                    ? new[] { primaryArtist }.Concat(otherArtists).ToList()
                    : otherArtists;

                // Fallback to single-value artist if no many-to-many data
                if (!allArtists.Any() && !string.IsNullOrEmpty(a.ArtistId))
                {
                    if (a.Artist != null)
                    {
                        allArtists = new List<Artist> { a.Artist };
                    }
                }

                var artistIds = allArtists.Select(ar => ar.Id).ToArray();
                var artistNames = allArtists.Select(ar => ar.Name).ToArray();

                // Build genre list: primary genre first (matching single-value Genre), then others alphabetically
                var primaryGenre = a.AlbumGenres
                    .FirstOrDefault(ag => ag.Genre != null && ag.Genre.Name == a.Genre)
                    ?.Genre;
                var otherGenres = a.AlbumGenres
                    .Where(ag => ag.Genre != null && ag.Genre.Name != a.Genre)
                    .Select(ag => ag.Genre!)
                    .Distinct()
                    .OrderBy(g => g.Name)
                    .ToList();

                var allGenres = primaryGenre != null
                    ? new[] { primaryGenre }.Concat(otherGenres).ToList()
                    : otherGenres;

                // Fallback to single-value genre if no many-to-many data
                string[] genres;
                if (!allGenres.Any() && !string.IsNullOrEmpty(a.Genre))
                {
                    // No many-to-many data, use single-value string
                    genres = new[] { a.Genre };
                }
                else
                {
                    genres = allGenres.Select(g => g.Name).ToArray();
                }

                return new AlbumResult
                {
                    Id = a.Id,
                    Title = a.Title,
                    ArtistId = a.ArtistId,
                    ArtistName = a.Artist?.Name ?? string.Empty,
                    ArtistIds = artistIds,
                    ArtistNames = artistNames,
                    Genres = genres,
                    Year = a.Year ?? a.ReleaseYear,
                    CoverArtPath = a.CoverArtPath,
                    TrackCount = trackCounts.TryGetValue(a.Id, out var count) ? count : 0
                };
            }).ToList();

            // Search tracks
            var tracksList = await DbContext.Tracks
                .Include(t => t.Artist)
                .Include(t => t.Album)
                .Include(t => t.TrackArtists).ThenInclude(ta => ta.Artist)
                .Include(t => t.TrackGenres).ThenInclude(tg => tg.Genre)
                .Where(t => t.Title.ToLower().Contains(searchTerm) ||
                           (t.Artist != null && t.Artist.Name.ToLower().Contains(searchTerm)) ||
                           (t.Genre != null && t.Genre.ToLower().Contains(searchTerm)) ||
                           t.TrackArtists.Any(ta => ta.Artist != null && ta.Artist.Name.ToLower().Contains(searchTerm)) ||
                           t.TrackGenres.Any(tg => tg.Genre != null && tg.Genre.Name.ToLower().Contains(searchTerm)))
                .OrderBy(t => t.Title.Length)
                .ThenBy(t => t.Title)
                .Take(limit)
                .ToListAsync();

            trackResults = tracksList.Select(t =>
            {
                // Build ordered artist list: primary artist first, then others alphabetically
                var primaryArtist = t.TrackArtists
                    .FirstOrDefault(ta => ta.ArtistId == t.ArtistId && ta.Artist != null)
                    ?.Artist;

                // If primary artist not found in many-to-many collection but exists in single-value field, use it
                if (primaryArtist == null && !string.IsNullOrEmpty(t.ArtistId) && t.Artist != null)
                {
                    primaryArtist = t.Artist;
                }

                var otherArtists = t.TrackArtists
                    .Where(ta => ta.Artist != null && ta.ArtistId != t.ArtistId)
                    .Select(ta => ta.Artist!)
                    .Distinct()
                    .OrderBy(ar => ar.Name)
                    .ToList();

                var allArtists = primaryArtist != null
                    ? new[] { primaryArtist }.Concat(otherArtists).ToList()
                    : otherArtists;

                // Fallback to single-value artist if no many-to-many data
                if (!allArtists.Any() && !string.IsNullOrEmpty(t.ArtistId))
                {
                    if (t.Artist != null)
                    {
                        allArtists = new List<Artist> { t.Artist };
                    }
                }

                var artistIds = allArtists.Select(ar => ar.Id).ToArray();
                var artistNames = allArtists.Select(ar => ar.Name).ToArray();

                // Build genre list: primary genre first (matching single-value Genre), then others alphabetically
                var primaryGenre = t.TrackGenres
                    .FirstOrDefault(tg => tg.Genre != null && tg.Genre.Name == t.Genre)
                    ?.Genre;
                var otherGenres = t.TrackGenres
                    .Where(tg => tg.Genre != null && tg.Genre.Name != t.Genre)
                    .Select(tg => tg.Genre!)
                    .Distinct()
                    .OrderBy(g => g.Name)
                    .ToList();

                var allGenres = primaryGenre != null
                    ? new[] { primaryGenre }.Concat(otherGenres).ToList()
                    : otherGenres;

                // Fallback to single-value genre if no many-to-many data
                string[] genres;
                if (!allGenres.Any() && !string.IsNullOrEmpty(t.Genre))
                {
                    // No many-to-many data, use single-value string
                    genres = new[] { t.Genre };
                }
                else
                {
                    genres = allGenres.Select(g => g.Name).ToArray();
                }

                return new TrackResult
                {
                    Id = t.Id,
                    Title = t.Title,
                    ArtistId = t.ArtistId,
                    ArtistName = t.Artist != null ? t.Artist.Name : string.Empty,
                    ArtistIds = artistIds,
                    ArtistNames = artistNames,
                    Genres = genres,
                    AlbumId = t.AlbumId,
                    AlbumTitle = t.Album != null ? t.Album.Title : null,
                    DurationMs = t.DurationMs,
                    TrackNumber = t.TrackNumber,
                    DiscNumber = t.DiscNumber
                };
            }).ToList();

            totalResults = artistResults.Count + albumResults.Count + trackResults.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            artistResults.Clear();
            albumResults.Clear();
            trackResults.Clear();
        }
        finally
        {
            isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearSearch()
    {
        searchQuery = "";
        artistResults.Clear();
        albumResults.Clear();
        trackResults.Clear();
        isExpanded = false;
    }

    private void NavigateToArtist(string artistId)
    {
        isExpanded = false;
        Navigation.NavigateTo($"/admin/artists/{artistId}");
    }

    private void NavigateToAlbum(string albumId)
    {
        isExpanded = false;
        Navigation.NavigateTo($"/admin/albums/{albumId}");
    }

    private void NavigateToTrack(string trackId)
    {
        isExpanded = false;
        Navigation.NavigateTo($"/admin/tracks/{trackId}");
    }

    private void ViewAllResults()
    {
        isExpanded = false;
        Navigation.NavigateTo($"/admin/search?q={Uri.EscapeDataString(searchQuery)}");
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }

    private class ArtistResult
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public int AlbumCount { get; set; }
        public int TrackCount { get; set; }
    }

    private class AlbumResult
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string[] ArtistIds { get; set; } = Array.Empty<string>();
        public string[] ArtistNames { get; set; } = Array.Empty<string>();
        public string[] Genres { get; set; } = Array.Empty<string>();
        public int? Year { get; set; }
        public string? CoverArtPath { get; set; }
        public int TrackCount { get; set; }
    }

    private class TrackResult
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ArtistId { get; set; } = "";
        public string ArtistName { get; set; } = "";
        public string[] ArtistIds { get; set; } = Array.Empty<string>();
        public string[] ArtistNames { get; set; } = Array.Empty<string>();
        public string[] Genres { get; set; } = Array.Empty<string>();
        public string? AlbumId { get; set; }
        public string? AlbumTitle { get; set; }
        public int DurationMs { get; set; }
        public int? TrackNumber { get; set; }
        public int? DiscNumber { get; set; }
    }
}