# Audiarr Production Environment Variables
# Copy this file to .env and update with your values

# Music Library Path
MUSIC_LIBRARY_PATH=/path/to/your/music/library

# JWT Configuration - IMPORTANT: Change these in production!
JWT_SECRET_KEY=YourSuperSecretKeyThatShouldBeAtLeast32Characters!
JWT_ISSUER=AudiarrAPI
JWT_AUDIENCE=AudiarrClient
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Optional: Docker Registry (for CI/CD)
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-username
DOCKER_IMAGE_NAME=audiarr

# Optional: Port Configuration
HOST_PORT=8080