# Audiarr Docker Environment Configuration
# Copy this file to .env and customize for your setup

# === REQUIRED CONFIGURATION ===

# Path to your music library on the host system
MUSIC_PATH=/path/to/your/music

# === OPTIONAL CONFIGURATION ===

# Timezone (defaults to UTC if not set)
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Port to expose Audiarr on (defaults to 8080)
HOST_PORT=8080

# Docker image tag to use (defaults to 'latest')
# Options: latest, edge, dev, or specific version like v1.0.0
AUDIARR_TAG=latest

# === ADVANCED CONFIGURATION (usually not needed) ===

# JWT Configuration (Audiarr generates secure defaults if not set)
# JWT_SECRET_KEY=YourSuperSecretKeyThatShouldBeAtLeast32Characters!
# JWT_ISSUER=AudiarrAPI
# JWT_AUDIENCE=AudiarrClient
# JWT_EXPIRATION_MINUTES=60
# JWT_REFRESH_EXPIRATION_DAYS=7